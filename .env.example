# ============================================================
# AI Agent Execution Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- FastAPI ---
ENVIRONMENT=development
DEBUG=True
API_TITLE="AI Agent Execution Platform"
API_VERSION="0.1.0"
SECRET_KEY="your-secret-key-here-change-in-production"

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_platform
DATABASE_ECHO=False

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- LLM Providers ---
GROQ_API_KEY=your-groq-key-here
GEMINI_API_KEY=your-gemini-key-here
OLLAMA_BASE_URL=http://localhost:11434
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=60

# --- Tools ---
FILE_TOOL_ROOT=./uploads
PYTHON_TOOL_TIMEOUT_SECONDS=10
TOOL_TIMEOUT_SECONDS=30

# --- Monitoring ---
PROMETHEUS_ENABLED=True
LOG_LEVEL=INFO
